<?xml version="1.0"?>
<robot name="diffbot"
  xmlns:xacro="http://www.ros.org/wiki/xacro"
  xmlns:gazebo="http://www.gazebosim.org/schema/gazebo_urdf">

  <!-- ======================= -->
  <!-- === Propiedades === -->
  <!-- Definición de propiedades reutilizables: masas, colores, dimensiones de ruedas y caster -->
  <xacro:property name="chassis_mass" value="0.800" /> <!-- 800g -->
  <!-- Radio de la rueda en metros -->
  <xacro:property name="wheel_radius" value="0.035" /> <!-- 70mm de diámetro = 35mm de radio -->
  <!-- Ancho de la rueda en metros -->
  <xacro:property name="wheel_width" value="0.025" /> <!-- 25mm de ancho -->
  <!-- Ancho entre ruedas en metros -->
  <xacro:property name="wheel_separation" value="0.100" /> <!-- 100mm de ancho del chasis -->
  <!-- Separación entre ruedas en metros -->
  <xacro:property name="caster_origin_xyz" value="-0.075 0 -0.0075" /> <!-- Posición del caster respecto al chasis -->
  <!-- Posición del caster respecto al chasis -->

  <xacro:property name="base_elevation" value="0.055" />
  <!-- Colores definidos en materials.xacro -->
  <!-- <xacro:property name="base_color" value="green" />
  <xacro:property name="wheel_color" value="silver" />
  <xacro:property name="caster_color" value="orange" /> -->


  <!-- ======================= -->
  <!-- === Includes === -->
  <!-- Inclusión de archivos xacro auxiliares para macros de inercia y motor -->
  <xacro:include filename="$(find diffbot_description)/urdf/inertial_macros.xacro" />
  <!-- <xacro:include filename="$(find diffbot_description)/urdf/materials.xacro" /> -->
  <xacro:include filename="$(find diffbot_description)/urdf/motor.xacro" />

  <!-- ======================= -->
  <!-- === Chasis del robot === -->
  <!-- Link principal del robot: el chasis -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find diffbot_description)/meshes/chassis.stl"/>
      </geometry>
      <material name="chassis_green">
        <color rgba="0.0 0.8 0.0 1.0"/>
      </material>
      <!-- Color que se visualiza en RViz-->
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.195 0.1 0.005" />
      </geometry>
    </collision>

    <xacro:inertial_box mass="0.8" x="0.195" y="0.100" z="0.005">
      <origin xyz="0 0 0.0525" rpy="0 0 0" />
    </xacro:inertial_box>
  </link>

  <!-- ======================= -->
  <!-- === Macro para ruedas === -->
  <!-- Macro reutilizable para definir una rueda y su joint asociado. Parametrizado por radio y
  separación. -->
  <xacro:macro name="wheel" params="prefix xyz axis rpy">

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link" />
      <child link="${prefix}_wheel_link" />
      <origin xyz="${xyz}" rpy="${rpy}" />
      <axis xyz="${axis}" />
    </joint>

    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0" />
        <geometry>
          <mesh filename="file://$(find diffbot_description)/meshes/wheel.stl"/>
        </geometry>
        <material name="wheel_silver">
          <color rgba="0.79 0.82 0.93 1"/>
        </material>
        <!-- Color que se visualiza en RViz-->
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0" />
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wheel_silver_collision">
          <color rgba="0.79 0.82 0.93 1"/>
        </material>
      </collision>

      <xacro:inertial_cylinder mass="0.150" radius="${wheel_radius}" length="${wheel_width}"> <!-- 150g -->
        <origin xyz="0 0 0" rpy="0 0 0" />
      </xacro:inertial_cylinder>
    </link>

  </xacro:macro>

  <!-- ======================= -->
  <!-- === Ruedas y motores === -->
  <!-- Instanciación de ruedas y motores usando las macros -->
  <xacro:wheel prefix="left" xyz="0.0185  0.05 -0.0175" axis="0 1 0" rpy="0 1.5708 0"/> <!-- Posición rueda izquierda -->
  <xacro:wheel prefix="right" xyz="0.0185 -0.05 -0.0175" axis="0 -1 0" rpy="0 1.5708 3.14159"/> <!-- Posición rueda derecha -->
  <!-- Motores -->
  <xacro:motor prefix="left" chassis_width="0.1" reflect="false" />
  <xacro:motor prefix="right" chassis_width="0.1" reflect="true" />

  <!-- ======================= -->
  <!-- === Caster (rueda loca) === -->
  <!-- Definición del caster y sus componentes -->
  <!-- BASE FIJA -->

  <joint name="caster_base_joint" type="fixed">
    <parent link="base_link" />
    <child link="caster" />
    <origin xyz="${caster_origin_xyz}" rpy="0 0 0" />
  </joint>

  <!-- BASE FIJA  -->
  <link name="caster">
    <visual>
      <origin xyz="0 0 0.0045" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find diffbot_description)/meshes/caster_base.stl" />
      </geometry>
      <material name="caster_orange">
        <color rgba="1 0.3 0.1 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.0045" rpy="0 0 0" />
      <geometry>
        <box size="0.032 0.038 0.015" />
      </geometry>
    </collision>

    <xacro:inertial_box mass="0.020" x="0.032" y="0.038" z="0.015"> <!-- 20g -->
      <origin xyz="0 0 0" rpy="0 0 0" />
    </xacro:inertial_box>
  </link>

  <!-- Rueda loca -->
  <joint name="caster_wheel_joint" type="continuous">
    <parent link="caster_wheel_support" />
    <child link="caster_wheel" />
    <origin xyz="-0.015 0 -0.020" rpy="0 0 0" /> <!-- Posición de la rueda giratoria respecto al soporte -->
    <axis xyz="0 1 0" />
  </joint>

  <!-- RUEDA MOVIL  -->
  <link name="caster_wheel">
    <visual>
      <!-- Rotamos el cilindro 90° alrededor del eje X para que su eje de giro sea el eje Y -->
      <origin xyz="0 0 0" rpy="0 0 0" />
      <!--1.5708-->
      <geometry>
        <mesh filename="file://$(find diffbot_description)/meshes/caster_wheel.stl" />
      </geometry>
      <material name="caster_wheel_orange">
        <color rgba="1 0.3 0.1 1"/>
      </material>
    </visual>

    <collision>
      <!-- Ajustado para evitar que la rueda esté por debajo del suelo -->
      <!-- -0.007 -->
      <origin xyz="0 0 -0.0075" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.0075" length="0.015" />
      </geometry>
    </collision>

    <!-- Inercia orientada correctamente -->
    <xacro:inertial_cylinder mass="0.010" radius="0.0075" length="0.015"> <!-- 10g, 15mm diámetro = 7.5mm radio -->
      <origin xyz="0 0 0" rpy="0 0 0" />
    </xacro:inertial_cylinder>
  </link>

  <!-- Soporte de la rueda loca -->
  <joint name="caster_wheel_support_joint" type="continuous">
    <parent link="base_link" />
    <child link="caster_wheel_support" />
    <origin xyz="-0.075 0 -0.015" rpy="0 0 0" /> <!-- Posición del soporte de la rueda giratoria -->
    <axis xyz="0 0 1" />
  </joint>

  <link name="caster_wheel_support">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find diffbot_description)/meshes/caster_wheel_support.stl" />
      </geometry>
      <material name="caster_support_orange">
        <color rgba="1 0.3 0.1 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.033 0.025 0.025" />
      </geometry>
    </collision>

    <xacro:inertial_box mass="0.020" x="0.033" y="0.025" z="0.025"> <!-- 20g -->
      <origin xyz="0 0 0" rpy="0 0 0" />
    </xacro:inertial_box>
  </link>


  <!-- Configuración de ros2_control para la interfaz de hardware -->
  <!-- El nombre "GazeboSystem" y el tipo "system" son estándar para la integración con Gazebo. -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <!-- Plugin de Gazebo para ROS 2 Control -->
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="left_wheel_joint">
      <command_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>

    <joint name="right_wheel_joint">
      <command_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>

    <joint name="caster_wheel_joint">
      <state_interface name="position" />
    </joint>

    <joint name="caster_wheel_support_joint">
      <state_interface name="position" />
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find diffbot_control)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

  <!-- ================================== SENSORES =============================================-->

    <!-- ================= IMU COMENTADA =================
  <link name="imu_link">
    <xacro:dummy_inertial />
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
  </joint>

  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <plugin name="gz::sim::systems::Imu" filename="gz-sim-imu-system">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <topic>/imu/data</topic>
        <visualize>true</visualize>
      </plugin>

      <imu>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.020</mean>
              <stddev>0.0016</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.020</mean>
              <stddev>0.0016</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.020</mean>
              <stddev>0.0019</stddev>
            </noise>
          </z>
        </linear_acceleration>

        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0174533</mean>
              <stddev>0.00174533</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0174533</mean>
              <stddev>0.00174533</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0174533</mean>
              <stddev>0.00174533</stddev>
            </noise>
          </z>
        </angular_velocity>
      </imu>
    </sensor>
  </gazebo>
================= FIN IMU COMENTADA ================= -->

  <!-- Link del sensor LiDAR -->
  <link name="lidar_link">
    <!-- Inercial ,no funciona dummy -->
    <xacro:dummy_inertial />
  </link>

  <!-- Joint fijo entre base_link y lidar_link -->
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
  </joint>

  <!-- PLUGGIN VALIDO PARA LIDAR Y OTROS SENSORES, SIN COSAS RARAS-->
  <gazebo>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
  </gazebo>

<!-- Sensor LiDAR en Gazebo -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <topic>/scan</topic>
      <visualize>true</visualize>
    
      <lidar>
        <scan>
          <horizontal>
            <samples>3200</samples>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
            <resolution>1</resolution>
          </horizontal>
        </scan>
        <range>
          <min>0.05</min>
          <max>15.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.03</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

</robot>