<?xml version="1.0"?>
<robot name="diffbot"
  xmlns:xacro="http://www.ros.org/wiki/xacro"
  xmlns:gazebo="http://www.gazebosim.org/schema/gazebo_urdf">

  <!-- ======================= -->
  <!-- === Propiedades === -->
  <!-- Parámetros reutilizables -->
  <xacro:property name="chassis_mass" value="0.8"/>
  <xacro:property name="chassis_length" value="0.195"/>
  <xacro:property name="chassis_width" value="0.1"/>
  <xacro:property name="chassis_height" value="0.005"/>

  <xacro:property name="wheel_radius" value="0.035"/>
  <xacro:property name="wheel_separation" value="0.135"/>
  <!-- Colores definidos en materials.xacro -->
  <!-- <xacro:property name="base_color" value="green" />
  <xacro:property name="wheel_color" value="silver" />
  <xacro:property name="caster_color" value="orange" /> -->


  <!-- ======================= -->
  <!-- === Includes === -->
  <!-- Inclusión de archivos xacro auxiliares para macros de inercia y motor -->
  <xacro:include filename="$(find diffbot_description)/urdf/materials.xacro" />
  <xacro:include filename="$(find diffbot_description)/urdf/inertial_macros.xacro" />
  <xacro:include filename="$(find diffbot_description)/urdf/motor.xacro" />

  <!-- ======================= -->
  <!-- === Chasis del robot === -->
  <!-- Link principal del robot: el chasis -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find diffbot_description)/meshes/chassis.stl"/>
      </geometry>
      <material name="chassis_green">
        <color rgba="0.0 0.8 0.0 1.0"/>
      </material>
      <!-- Color que se visualiza en RViz-->
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}" />
      </geometry>
    </collision>

    <xacro:inertial_box mass="${chassis_mass}" x="${chassis_length}" y="${chassis_width}" z="0.00">
      <origin xyz="0 0 0" rpy="0 0 0" />
    </xacro:inertial_box>
  </link>

  <!-- ======================= -->
  <!-- === Macro para ruedas === -->
  <!-- Macro reutilizable para definir una rueda y su joint asociado. Parametrizado por radio y
  separación. -->
  <xacro:macro name="wheel" params="prefix xyz axis rpy">

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link" />
      <child link="${prefix}_wheel_link" />
      <origin xyz="${xyz}" rpy="${rpy}" />
      <axis xyz="${axis}" />
    </joint>

    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 -0.020 0" rpy="1.5708 0 0" />
        <geometry>
          <mesh filename="file://$(find diffbot_description)/meshes/wheel.stl"/>
        </geometry>
        <material name="dark_grey"/>
      </visual>

      <collision>
        <origin xyz="0 -0.020 0" rpy="1.5708 0 0" />
        <geometry>
          <cylinder radius="${wheel_radius}" length="0.025"/>
        </geometry>
        <material name="dark_grey"/>
      </collision>

      <xacro:inertial_cylinder mass="0.150" radius="${wheel_radius}" length="0.025">
        <origin xyz="0 0 0" rpy="0 0 0" />
      </xacro:inertial_cylinder>
    </link>

  </xacro:macro>

  <!-- ======================= -->
  <!-- === Ruedas y motores === -->
  <!-- Instanciación de ruedas y motores usando las macros -->
  <xacro:wheel prefix="left" xyz="0.0185  ${wheel_separation/2} -0.0175" axis="0 1 0" rpy="0 1.5708 0"/>
  <xacro:wheel prefix="right" xyz="0.0185 -${wheel_separation/2} -0.0175" axis="0 -1 0" rpy="0 1.5708 3.14159"/>
  <!-- Motores -->
  <xacro:motor prefix="left" chassis_width="${chassis_width}" reflect="false"/>
  <xacro:motor prefix="right" chassis_width="${chassis_width}" reflect="true"/>

  <!-- ======================= -->
  <!-- === Caster (rueda loca) === -->
  <!-- Definición del caster y sus componentes -->
  <!-- BASE FIJA -->

  <link name="caster_base">
    <visual>
      <origin xyz="0 0 0.0045" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find diffbot_description)/meshes/caster_base.stl" />
      </geometry>
      <material name="caster_orange">
        <color rgba="1 0.3 0.1 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.0045" rpy="0 0 0" />
      <geometry>
        <box size="0.032 0.038 0.015" />
      </geometry>
    </collision>

    <xacro:inertial_box mass="0.02" x="0.032" y="0.038" z="0.015">
      <origin xyz="0 0 0" rpy="0 0 0" />
    </xacro:inertial_box>
  </link>
  
  <joint name="caster_base_joint" type="fixed">
    <origin xyz="-0.075 0 -0.001" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="caster_base"/>
  </joint>

  <!-- RUEDA MOVIL  -->
  <link name="caster_wheel">
    <visual>
      <!-- Rotamos el cilindro 90° alrededor del eje X para que su eje de giro sea el eje Y -->
      <origin xyz="0 0 0" rpy="0 0 0" />
      <!--1.5708-->
      <geometry>
        <mesh filename="file://$(find diffbot_description)/meshes/caster_wheel.stl" />
      </geometry>
      <material name="caster_wheel_orange">
        <color rgba="1 0.3 0.1 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 -0.007" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.015" length="0.016" />
      </geometry>
    </collision>

    <xacro:inertial_cylinder mass="0.01" radius="0.015" length="0.016">
      <origin xyz="0 0 0" rpy="0 0 0" />
    </xacro:inertial_cylinder>
  </link>

  <link name="caster_wheel_support">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find diffbot_description)/meshes/caster_wheel_support.stl" />
      </geometry>
      <material name="caster_support_orange">
        <color rgba="1 0.3 0.1 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.033 0.025 0.025" />
      </geometry>
    </collision>

    <xacro:inertial_box mass="0.02" x="0.033" y="0.025" z="0.025">
      <origin xyz="0 0 0" rpy="0 0 0" />
    </xacro:inertial_box>
  </link>
  
  <joint name="caster_wheel_support_joint" type="continuous">
    <origin xyz="0 0 -0.015" rpy="0 0 0"/>
    <parent link="caster_base"/>
    <child link="caster_wheel_support"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- Rueda loca -->
  <joint name="caster_wheel_joint" type="continuous">
    <origin xyz="-0.015 0 -0.020" rpy="0 0 0"/>
    <parent link="caster_wheel_support"/>
    <child link="caster_wheel"/>
    <axis xyz="0 1 0"/>
  </joint>


  <!-- Configuración de ros2_control para la interfaz de hardware -->
  <!-- El nombre "GazeboSystem" y el tipo "system" son estándar para la integración con Gazebo. -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <!-- Plugin de Gazebo para ROS 2 Control -->
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="left_wheel_joint">
      <command_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>

    <joint name="right_wheel_joint">
      <command_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>

    <joint name="caster_wheel_joint">
      <state_interface name="position" />
    </joint>

    <joint name="caster_wheel_support_joint">
      <state_interface name="position" />
    </joint>
  </ros2_control>

  <gazebo>
    <!--<plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">-->
    <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find diffbot_control)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

  <!-- ================================== SENSORES =============================================-->

    <!-- ================= IMU COMENTADA =================
  <link name="imu_link">
    <xacro:dummy_inertial />
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
  </joint>

  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <plugin name="gz::sim::systems::Imu" filename="gz-sim-imu-system">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <topic>/imu/data</topic>
        <visualize>true</visualize>
      </plugin>

      <imu>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.020</mean>
              <stddev>0.0016</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.020</mean>
              <stddev>0.0016</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.020</mean>
              <stddev>0.0019</stddev>
            </noise>
          </z>
        </linear_acceleration>

        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0174533</mean>
              <stddev>0.00174533</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0174533</mean>
              <stddev>0.00174533</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0174533</mean>
              <stddev>0.00174533</stddev>
            </noise>
          </z>
        </angular_velocity>
      </imu>
    </sensor>
  </gazebo>
================= FIN IMU COMENTADA ================= -->



  <!-- ======================= -->
  <!-- === SENSOR IMU === -->
  <!-- ======================= -->
    
  <!-- Link del IMU -->
  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.025 0.005"/>
      </geometry>
      <material name="imu_color">
        <color rgba="0.2 0.2 0.8 1.0"/>
      </material>
    </visual>
    
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.025 0.005"/>
      </geometry>
    </collision>
    
    <inertial>
      <mass value="0.001"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
  </link>

  <!-- Joint que conecta el IMU al link padre -->
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.0 0.0 0.05" rpy="0 0 0"/>
  </joint>

  <!-- Configuración del sensor IMU en Gazebo -->
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <plugin
        filename="gz-sim-imu-system" 
        name="gz::sim::systems::Imu">
      </plugin>

      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <topic>/imu/data</topic>
      <visualize>true</visualize>

      <imu>
        <!-- Configuración del acelerómetro BMI088 -->
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.020</mean>          <!-- Zero-g Offset: 20 mg -->
              <stddev>0.0016</stddev>     <!-- Noise Density X,Y: 160 μg/√Hz -->
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.020</mean>
              <stddev>0.0016</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.020</mean>
              <stddev>0.0019</stddev>     <!-- Noise Density Z: 190 μg/√Hz -->
            </noise>
          </z>
        </linear_acceleration>
        
        <!-- Configuración del giróscopo BMI088 -->
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0174533</mean>      <!-- Zero-rate Offset: ±1°/s en rad -->
              <stddev>0.00174533</stddev> <!-- Output Noise: 0.1°/s en rad -->
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0174533</mean>
              <stddev>0.00174533</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0174533</mean>
              <stddev>0.00174533</stddev>
            </noise>
          </z>
        </angular_velocity>
      </imu>
    </sensor>
  </gazebo>

  <!-- ======================= -->
  <!-- === SENSOR LIDAR === -->
  <!-- ======================= -->
    
  <!-- Link del LiDAR -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.07"/>
      </geometry>
      <material name="lidar_color">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.07"/>
      </geometry>
    </collision>
    
    <inertial>
      <mass value="0.190"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- Joint que conecta el LiDAR al link padre -->
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.0 0.0 0.12" rpy="0 0 0"/>
  </joint>

  <!-- Configuración del sensor LiDAR en Gazebo -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>10</update_rate>        <!-- Scanning Frequency: 10 Hz -->
      <topic>/scan</topic>
      <visualize>true</visualize>

      <lidar>
        <scan>
          <horizontal>
            <samples>3200</samples>           <!-- 360°/0.1125° = 3200 samples -->
            <resolution>1</resolution>
            <min_angle>-3.14159265359</min_angle>  <!-- -π rad -->
            <max_angle>3.14159265359</max_angle>   <!-- +π rad -->
          </horizontal>
          <!-- Al ser LiDAR 2D no tiene parámetros verticales -->
        </scan>
        
        <range>
          <min>0.05</min>                   <!-- Distance Range: 0.05 m -->
          <max>15.0</max>                   <!-- Distance Range: 15.0 m -->
          <resolution>0.010</resolution>    <!-- Resolution: 10 mm -->
        </range>
        
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.030</stddev>            <!-- Accuracy: ±30 mm -->
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- Plugin para sensores en Gazebo -->
  <gazebo>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
  </gazebo>



</robot>