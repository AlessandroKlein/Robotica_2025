<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Macro para sensor IMU BMI088 -->
  <xacro:macro name="sim_imu" params="parent_link">
    
    <!-- Link del IMU -->
    <link name="imu_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.025 0.025 0.005"/>
        </geometry>
        <material name="imu_color">
          <color rgba="0.2 0.2 0.8 1.0"/>
        </material>
      </visual>
      
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.025 0.025 0.005"/>
        </geometry>
      </collision>
      
      <inertial>
        <mass value="0.001"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
      </inertial>
    </link>

    <!-- Joint que conecta el IMU al link padre -->
    <joint name="imu_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child link="imu_link"/>
      <origin xyz="0.0 0.0 0.05" rpy="0 0 0"/>
    </joint>

    <!-- Configuración del sensor IMU en Gazebo -->
    <gazebo reference="imu_link">
      <sensor name="imu" type="imu">
        <plugin
          filename="gz-sim-imu-system" 
          name="gz::sim::systems::Imu">
        </plugin>

        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <topic>/imu/data</topic>
        <visualize>true</visualize>

        <imu>
          <!-- Configuración del acelerómetro BMI088 -->
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0.020</mean>          <!-- Zero-g Offset: 20 mg -->
                <stddev>0.0016</stddev>     <!-- Noise Density X,Y: 160 μg/√Hz -->
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.020</mean>
                <stddev>0.0016</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.020</mean>
                <stddev>0.0019</stddev>     <!-- Noise Density Z: 190 μg/√Hz -->
              </noise>
            </z>
          </linear_acceleration>
          
          <!-- Configuración del giróscopo BMI088 -->
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0.0174533</mean>      <!-- Zero-rate Offset: ±1°/s en rad -->
                <stddev>0.00174533</stddev> <!-- Output Noise: 0.1°/s en rad -->
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0174533</mean>
                <stddev>0.00174533</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0174533</mean>
                <stddev>0.00174533</stddev>
              </noise>
            </z>
          </angular_velocity>
        </imu>
      </sensor>
    </gazebo>

  </xacro:macro>

</robot>