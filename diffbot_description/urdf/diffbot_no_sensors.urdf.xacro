<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="diffbot">

  <!-- ======================= -->
  <!-- === Propiedades === -->
  <!-- Propiedades del robot: dimensiones del chasis y ruedas -->
  <xacro:property name="base_width" value="0.161"/>
  <xacro:property name="base_length" value="0.161"/>
  <xacro:property name="base_height" value="0.161"/>

  <xacro:property name="wheel_radius" value="0.033"/>
  <xacro:property name="wheel_width" value="0.025"/>
  <xacro:property name="wheel_ygap" value="0.025"/>
  <xacro:property name="wheel_zoff" value="0.05"/>
  <xacro:property name="wheel_xoff" value="0.062"/>

  <xacro:property name="caster_xoff" value="0.115"/>
  <xacro:property name="wheel_separation" value="0.135"/>

  <!-- ======================= -->
  <!-- === Includes === -->
  <xacro:include filename="$(find diffbot_description)/urdf/materials.xacro" />
  <xacro:include filename="$(find diffbot_description)/urdf/inertial_macros.xacro" />
  <xacro:include filename="$(find diffbot_description)/urdf/motor.xacro" />

  <!-- ======================= -->
  <!-- === Chasis del robot === -->
  <link name="base_link">
    <visual>
      <origin xyz="-0.0185 0 0.0175" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find diffbot_description)/meshes/chassis.stl"/>
      </geometry>
      <material name="chassis_green"/>
    </visual>

    <collision>
      <origin xyz="-0.0185 0 0.0175" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find diffbot_description)/meshes/chassis.stl"/>
      </geometry>
    </collision>

    <xacro:inertial_box mass="0.5" x="${base_length}" y="${base_width}" z="${base_height}">
      <origin xyz="0 0 0" rpy="0 0 0" />
    </xacro:inertial_box>
  </link>

  <!-- === Macro para ruedas === -->
  <xacro:macro name="wheel" params="prefix xyz axis rpy">
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link" />
      <child link="${prefix}_wheel_link" />
      <origin xyz="${xyz}" rpy="${rpy}" />
      <axis xyz="${axis}" />
    </joint>

    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 -0.020 0" rpy="1.5708 0 0" />
        <geometry>
          <mesh filename="file://$(find diffbot_description)/meshes/wheel.stl"/>
        </geometry>
        <material name="dark_grey"/>
      </visual>

      <collision>
        <origin xyz="0 -0.020 0" rpy="1.5708 0 0" />
        <geometry>
          <cylinder radius="${wheel_radius}" length="0.025"/>
        </geometry>
        <material name="dark_grey"/>
      </collision>

      <xacro:inertial_cylinder mass="0.150" radius="${wheel_radius}" length="0.025">
        <origin xyz="0 0 0" rpy="0 0 0" />
      </xacro:inertial_cylinder>
    </link>
  </xacro:macro>

  <!-- === Ruedas y motores === -->
  <xacro:wheel prefix="left" xyz="0.0185  ${wheel_separation/2} -0.0175" axis="0 1 0" rpy="0 1.5708 0"/>
  <xacro:wheel prefix="right" xyz="0.0185 -${wheel_separation/2} -0.0175" axis="0 -1 0" rpy="0 1.5708 3.14159"/>

  <!-- === Motores === -->
  <xacro:motor prefix="left" chassis_width="${base_width}" reflect="false" />
  <xacro:motor prefix="right" chassis_width="${base_width}" reflect="true" />

</robot>