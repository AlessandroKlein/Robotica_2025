<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Macro para sensor LiDAR Slamtec S3M1-R2 -->
  <xacro:macro name="sim_lidar" params="parent_link">
    
    <!-- Link del LiDAR -->
    <link name="lidar_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.05" length="0.07"/>
        </geometry>
        <material name="lidar_color">
          <color rgba="0.1 0.1 0.1 1.0"/>
        </material>
      </visual>
      
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.05" length="0.07"/>
        </geometry>
      </collision>
      
      <inertial>
        <mass value="0.190"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
    </link>

    <!-- Joint que conecta el LiDAR al link padre -->
    <joint name="lidar_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child link="lidar_link"/>
      <origin xyz="0.0 0.0 0.12" rpy="0 0 0"/>
    </joint>

    <!-- Configuración del sensor LiDAR en Gazebo -->
    <gazebo reference="lidar_link">
      <sensor name="lidar" type="gpu_lidar">
        <always_on>true</always_on>
        <update_rate>10</update_rate>        <!-- Scanning Frequency: 10 Hz -->
        <topic>/scan</topic>
        <visualize>true</visualize>

        <lidar>
          <scan>
            <horizontal>
              <samples>3200</samples>           <!-- 360°/0.1125° = 3200 samples -->
              <resolution>1</resolution>
              <min_angle>-3.14159265359</min_angle>  <!-- -π rad -->
              <max_angle>3.14159265359</max_angle>   <!-- +π rad -->
            </horizontal>
            <!-- Al ser LiDAR 2D no tiene parámetros verticales -->
          </scan>
          
          <range>
            <min>0.05</min>                   <!-- Distance Range: 0.05 m -->
            <max>15.0</max>                   <!-- Distance Range: 15.0 m -->
            <resolution>0.010</resolution>    <!-- Resolution: 10 mm -->
          </range>
          
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.030</stddev>            <!-- Accuracy: ±30 mm -->
          </noise>
        </lidar>
      </sensor>
    </gazebo>

  </xacro:macro>

</robot>