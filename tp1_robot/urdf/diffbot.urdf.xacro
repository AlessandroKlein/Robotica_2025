<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro"
       xmlns:gazebo="http://www.gazebosim.org/schema/gazebo_urdf"
       name="diffbot">

  <!-- ======================= -->
  <!-- === Propiedades === -->
  <!-- ======================= -->

  <xacro:property name="chassis_mass" value="0.800"/>
  <xacro:property name="base_color" value="green"/>
  <xacro:property name="wheel_radius" value="0.035"/> <!-- Radio de la rueda en metros -->
  <xacro:property name="wheel_width" value="0.025"/> <!-- Ancho de la rueda en metros -->
  <xacro:property name="wheel_separation" value="0.16"/> <!-- Separación entre ruedas en metros -->
  <xacro:property name="wheel_color" value="silver"/>
  <xacro:property name="caster_origin_xyz" value="-0.075 0 -0.0075"/> <!-- Posición del caster respecto al chasis -->
  <xacro:property name="caster_color" value="orange"/>

  <!-- ======================= -->
  <!-- === Includes === -->
  <!-- ======================= -->

  <xacro:include filename="$(find tp1_robot)/urdf/inertial_macros.xacro"/>
  <xacro:include filename="$(find tp1_robot)/urdf/motor.xacro"/>

  <!-- ======================= -->
  <!-- === Chasis del robot === -->
  <!-- ======================= -->

  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="file://$(find tp1_robot)/meshes/chassis.stl"/>
      </geometry>
      <material name="${base_color}"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.195 0.1 0.05"/> <!-- Tamaño del chasis (x: largo, y: ancho, z: alto) -->
      </geometry>
    </collision>
    <xacro:inertial_box mass="${chassis_mass}" x="0.195" y="0.1" z="0.05"/>
  </link>

  <!-- ======================= -->
  <!-- === Macro para ruedas === -->
  <!-- ======================= -->

  <xacro:macro name="wheel" params="prefix xyz axis rpy">
    <link name="${prefix}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <mesh filename="file://$(find tp1_robot)/meshes/wheel.stl"/>
        </geometry>
        <material name="${wheel_color}"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <!-- Contacto dentro de collision -->
        <contact>
          <ode>
            <min_depth>0.001</min_depth>
            <kp>1e3</kp>
            <kd>1e1</kd>
          </ode>
        </contact>
      </collision>
      <xacro:inertial_cylinder mass="0.150" radius="${wheel_radius}" length="${wheel_width}">
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:inertial_cylinder>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <axis xyz="${axis}"/>
      <limit effort="10.0" velocity="10.0"/>
      <dynamics damping="0.1"/>
    </joint>

    <!-- Gazebo settings -->
    <gazebo reference="${prefix}_wheel">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <material>Gazebo/Grey</material>
    </gazebo>
  </xacro:macro>

  <!-- ======================= -->
  <!-- === Ruedas y motores === -->
  <!-- ======================= -->

  <xacro:wheel prefix="left" xyz="0.0185  0.05 -0.0175" axis="0 1 0" rpy="0 1.5708 0"/>
  <xacro:wheel prefix="right" xyz="0.0185 -0.05 -0.0175" axis="0 1 0" rpy="0 1.5708 3.14159"/>
  <xacro:motor prefix="left" chassis_width="0.1" reflect="false"/>
  <xacro:motor prefix="right" chassis_width="0.1" reflect="true"/>

  <!-- ======================= -->
  <!-- === Caster === -->
  <!-- ======================= -->

  <link name="caster">
    <visual>
      <origin xyz="0 0 0.0045" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find tp1_robot)/meshes/caster_base.stl"/>
      </geometry>
      <material name="${caster_color}"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.0045" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.01"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.020"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster"/>
    <origin xyz="${caster_origin_xyz}" rpy="0 0 0"/>
  </joint>

  <link name="caster_wheel">
    <visual>
      <origin xyz="-0.015 0 -0.020" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find tp1_robot)/meshes/caster_wheel.stl"/>
      </geometry>
      <material name="${caster_color}"/>
    </visual>
    <collision>
      <origin xyz="-0.015 0 -0.030" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.01"/>
      </geometry>
      <contact>
        <ode>
          <min_depth>0.001</min_depth>
          <kp>1e3</kp>
          <kd>1e1</kd>
        </ode>
      </contact>
    </collision>
    <xacro:inertial_cylinder mass="0.150" radius="0.015" length="0.015">
      <origin xyz="-0.015 0 -0.030" rpy="0 0 0"/>
    </xacro:inertial_cylinder>
  </link>

  <joint name="caster_wheel_joint" type="continuous">
    <parent link="caster"/>
    <child link="caster_wheel"/>
    <origin xyz="0 0 -0.01" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="caster_wheel_support">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find tp1_robot)/meshes/caster_wheel_support.stl"/>
      </geometry>
      <material name="${caster_color}"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.020"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="caster_support_joint" type="fixed">
    <parent link="caster_wheel"/>
    <child link="caster_wheel_support"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ======================= -->
  <!-- === Frame odométrico === -->
  <!-- ======================= -->

  <link name="odom"/>
  <joint name="odom_to_base_link" type="fixed">
    <parent link="odom"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ======================= -->
  <!-- === ros2_control === -->
  <!-- ======================= -->

  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      <param name="robot_param">robot_description</param>
      <param name="legacy_mode">false</param>
      <param name="update_rate">100.0</param>
    </hardware>

    <!-- Interfaces para control diferencial -->
    <joint name="left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- Solo estado para caster -->
    <joint name="caster_wheel_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- ============================ -->
  <!-- === Plugin para Gazebo ==== -->
  <!-- ============================ -->

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find tp1_robot)/config/diff_drive_controller.yaml</parameters>
      <robot_sim_type>gz_ros2_control/GazeboSimSystem</robot_sim_type>
      <control_period>0.01</control_period> <!-- 100 Hz -->
    </plugin>
  </gazebo>

  <!-- Material base para evitar warnings -->
  <gazebo reference="base_link">
    <material>Gazebo/Black</material>
  </gazebo>

  <!-- Parámetros físicos para las ruedas -->
  <gazebo reference="left_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <fdir1>1 0 0</fdir1>
    <material>Gazebo/Rubber</material>
    <kp>1e3</kp>
    <kd>1e1</kd>
    <maxContacts>10</maxContacts>
  </gazebo>

  <gazebo reference="right_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <fdir1>1 0 0</fdir1>
    <material>Gazebo/Rubber</material>
    <kp>1e3</kp>
    <kd>1e1</kd>
    <maxContacts>10</maxContacts>
  </gazebo>

  <gazebo reference="caster_wheel">
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
    <kp>1e3</kp>
    <kd>1e1</kd>
    <maxContacts>10</maxContacts>
  </gazebo>

  <!-- Ganancias PID (opcional, pero útiles) -->
  <gazebo reference="left_wheel">
    <position_proportional_gain>10.0</position_proportional_gain>
    <velocity_proportional_gain>1.0</velocity_proportional_gain>
    <velocity_integral_gain>0.01</velocity_integral_gain>
    <velocity_derivative_gain>0.0</velocity_derivative_gain>
  </gazebo>

  <gazebo reference="right_wheel">
    <position_proportional_gain>10.0</position_proportional_gain>
    <velocity_proportional_gain>1.0</velocity_proportional_gain>
    <velocity_integral_gain>0.01</velocity_integral_gain>
    <velocity_derivative_gain>0.0</velocity_derivative_gain>
  </gazebo>

</robot>