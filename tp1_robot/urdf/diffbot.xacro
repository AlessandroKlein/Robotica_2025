<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="diffbot">

  <!-- ======================= -->
  <!-- === Propiedades === -->
  <!-- Definición de propiedades reutilizables como masas, colores, dimensiones de ruedas y caster -->
  <xacro:property name="chassis_mass" value="0.800"/>
  <xacro:property name="wheel_radius" value="0.035"/> <!-- Radio de la rueda en metros -->
  <xacro:property name="wheel_width" value="0.025"/> <!-- Ancho de la rueda en metros -->
  <xacro:property name="wheel_separation" value="0.16"/> <!-- Separación entre ruedas en metros -->
  <xacro:property name="caster_origin_xyz" value="-0.075 0 -0.0075"/> <!-- Posición del caster respecto al chasis -->
  
  <xacro:property name="base_elevation" value="0.01"/>
  <xacro:property name="base_color" value="green"/>
  <xacro:property name="wheel_color" value="silver"/>
  <xacro:property name="caster_color" value="orange"/>

  <xacro:property name="wheelSeparation" value="0.13"/>

  <!-- ======================= -->
  <!-- === Includes === -->
  <!-- Inclusión de archivos xacro auxiliares para definir macros de inercia y motor -->
  <xacro:include filename="$(find tp1_robot)/urdf/inertial_macros.xacro"/>
  <xacro:include filename="$(find tp1_robot)/urdf/motor.xacro"/>
  <xacro:include filename="$(find tp1_robot)/urdf/diffbot_gz.xacro"/>


  <link name="base_footprint"/>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_elevation}" rpy="0 0 0"/>
  </joint>

  <!-- ======================= -->
  <!-- === Chasis del robot === -->
  <!-- Definición del link principal del robot: el chasis -->
  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="file://$(find tp1_robot)/meshes/chassis.stl" scale="1 1 1"/>
      </geometry>
      <material name="${base_color}"/> <!-- Colo que se visualiza en RViz-->
    </visual>
    <collision>
      <geometry>
        <box size="0.195 0.1 0.05"/> <!-- Tamaño del chasis (x: largo, y: ancho, z: alto) -->
      </geometry>
    </collision>
    <xacro:inertial_box mass="${chassis_mass}" x="0.195" y="0.1" z="0.05"/>
  </link>

  <!-- ======================= -->
  <!-- === Macro para ruedas === -->
  <!-- Macro reutilizable para definir una rueda y su joint asociado -->
  <xacro:macro name="wheel" params="prefix xyz axis rpy">
    <joint name="wheel_${prefix}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="wheel_${prefix}_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <axis xyz="${axis}"/>
    </joint>

    <link name="wheel_${prefix}_link">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <mesh filename="file://$(find tp1_robot)/meshes/wheel.stl" scale="1 1 1"/>
        </geometry>
        <material name="${wheel_color}"/> <!-- Colo que se visualiza en RViz-->
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:inertial_cylinder mass="0.150" radius="${wheel_radius}" length="${wheel_width}">
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:inertial_cylinder>
    </link>
  </xacro:macro>

  <!-- ======================= -->
  <!-- === Ruedas y motores === -->
  <!-- Instanciación de las ruedas y motores usando las macros -->
  <xacro:wheel prefix="left" xyz="0.0185  0.05 -0.0175" axis="0 1 0" rpy="0 1.5708 0"/>
  <xacro:wheel prefix="right" xyz="0.0185 -0.05 -0.0175" axis="0 1 0" rpy="0 1.5708 3.14159"/>

  <xacro:motor prefix="left" chassis_width="0.1" reflect="false"/>
  <xacro:motor prefix="right" chassis_width="0.1" reflect="true"/>

  <!-- ======================= -->
  <!-- === Caster === -->
  <!-- Definición del caster (rueda loca) y sus componentes -->

  <joint name="caster_base_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster"/>
    <origin xyz="${caster_origin_xyz}" rpy="0 0 0"/>
  </joint>

  <link name="caster">
    <visual>
      <origin xyz="0 0 0.0045" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find tp1_robot)/meshes/caster_base.stl"/>
      </geometry>
      <material name="${caster_color}"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.0045" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.01"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.020"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- Rueda Loca -->

  <joint name="caster_wheel_joint" type="continuous">
    <parent link="caster_wheel_support"/>
    <child link="caster_wheel"/>
    <origin xyz="-0.015 0 -0.020" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  
  <link name="caster_wheel">
    <visual>
      <!-- Rotamos el cilindro 90° alrededor del eje X para que su eje de giro sea el eje Y -->
      <origin xyz="0 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <mesh filename="file://$(find tp1_robot)/meshes/caster_wheel.stl"/>
      </geometry>
      <material name="${caster_color}"/>
    </visual>
    <collision>
      <!-- Misma rotación para colisión -->
      <origin xyz="0 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.01"/>
      </geometry>
    </collision>
    <!-- Inercia orientada correctamente -->
    <xacro:inertial_cylinder mass="0.150" radius="0.02" length="0.01">
      <origin xyz="0 0 0" rpy="0 1.5708 0"/>
    </xacro:inertial_cylinder>
  </link>

  <!-- Soporte Rueda -->

  <joint name="caster_support_joint" type="continuous">
    <parent link="base_link"/>
    <child link="caster_wheel_support"/>
    <origin xyz="-0.075 0 -0.018" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="caster_wheel_support">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find tp1_robot)/meshes/caster_wheel_support.stl"/>
      </geometry>
      <material name="${caster_color}"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.020"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- ======================= -->
  <!-- === ros2_control === -->
  <!-- ======================= -->

  <ros2_control name="DiffbotSystemHardware" type="system">
    <hardware>
      <plugin>mock_components/GenericSystem</plugin>
    </hardware>

    <joint name="left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="caster_wheel_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

</robot>