<?xml version="1.0"?>

<sdf version="1.6">
  <model name='LineTrack'>
    <static>true</static>
    <link name="track">
      <pose>0 0 0 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <mesh><uri>model://LineTrack/meshes/track.obj</uri></mesh>
          </geometry>
        </visual>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
    </link>

    <link name='wall_xp'>
      <pose>2.525 0 0.5 0 0 0</pose><!--pose relative to the world-->
      <visual name='visual'>
        <geometry>
          <box>
            <size>0.05 5.1 1.0</size>
          </box>
        </geometry>
        <!--let's add color to our link-->
        <material>
          <ambient> 0.819 0.38 0.364 1</ambient>
          <diffuse> 0.819 0.38 0.364 1</diffuse>
          <specular>0.819 0.38 0.364 1</specular>
        </material>
      </visual>
      <collision name='collision'> <!--todo: describe why we need the collision-->
        <geometry>
          <box>
            <size>0.05 5.1 1.0</size>
          </box>
        </geometry>
      </collision>
    </link>

    <link name='wall_xm'>
      <pose>-2.525 0 0.5 0 0 0</pose><!--pose relative to the world-->
      <visual name='visual'>
        <geometry>
          <box>
            <size>0.05 5.1 1.0</size>
          </box>
        </geometry>
        <!--let's add color to our link-->
        <material>
          <ambient> 0.894 0.580 0.267 1</ambient>
          <diffuse> 0.894 0.580 0.267 1</diffuse>
          <specular>0.894 0.580 0.267 1</specular>
        </material>
      </visual>
      <collision name='collision'> <!--todo: describe why we need the collision-->
        <geometry>
          <box>
            <size>0.05 5.1 1.0</size>
          </box>
        </geometry>
      </collision>
    </link>

    <link name='wall_yp'>
      <pose>0 2.525 0.5 0 0 1.57079632679</pose><!--pose relative to the world-->
      <visual name='visual'>
        <geometry>
          <box>
            <size>0.05 5.1 1.0</size>
          </box>
        </geometry>
        <!--let's add color to our link-->
        <material>
          <ambient> 0.416 0.623 0.345 1</ambient>
          <diffuse> 0.416 0.623 0.345 1</diffuse>
          <specular>0.416 0.623 0.345 1</specular>
        </material>
      </visual>
      <collision name='collision'> <!--todo: describe why we need the collision-->
        <geometry>
          <box>
            <size>0.05 5.1 1.0</size>
          </box>
        </geometry>
      </collision>
    </link>

    <link name='wall_ym'>
      <pose>0 -2.525 0.5 0 0 1.57079632679</pose><!--pose relative to the world-->
      <visual name='visual'>
        <geometry>
          <box>
            <size>0.05 5.1 1.0</size>
          </box>
        </geometry>
        <!--let's add color to our link-->
        <material>
          <ambient> 0.341 0.470 0.643 1</ambient>
          <diffuse> 0.341 0.470 0.643 1</diffuse>
          <specular>0.341 0.470 0.643 1</specular>
        </material>
      </visual>
      <collision name='collision'> <!--todo: describe why we need the collision-->
        <geometry>
          <box>
            <size>0.05 5.1 1.0</size>
          </box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
